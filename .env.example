# Controller Configuration
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8000
DATABASE_URL=sqlite:///./cloud_controller.db
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15
RECONCILIATION_INTERVAL=10

# Security (Shared authentication token between Controller and Node Agents)
NODE_AUTH_TOKEN=ps023-hackathon-token-secret-xyz

# Node Agent Configuration (Individual to each node)
NODE_ID=node-a
NODE_HOST=127.0.0.1
NODE_PORT=8001
CONTROLLER_URL=http://127.0.0.1:8000

# Virtualization Engine (Set DEMO_MODE=true for simulation, false for real KVM/libvirt)
DEMO_MODE=true
LIBVIRT_URI=qemu:///system

# Storage Paths
VM_STORAGE_DIR=/tmp/ps023/disks
BASE_IMAGE_DIR=/tmp/ps023/images
